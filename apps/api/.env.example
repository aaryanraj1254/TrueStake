PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Third-party live data providers
CRICAPI_KEY=your-cricapi-key
ALPHAVANTAGE_KEY=your-alphavantage-key
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# Observability
SENTRY_DSN=

# Email
RESEND_API_KEY=your-resend-key
RESEND_FROM=TrueStake <no-reply@truestake.app>

# Razorpay (test keys start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Web Push (VAPID) — run `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@truestake.app

# Anthropic API key (https://console.anthropic.com) for "Ask AI" predictions
ANTHROPIC_API_KEY=

# Reddit script app (https://reddit.com/prefs/apps) — optional, falls back to public JSON
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=truestake/1.0 (by /u/yourusername)

# NewsAPI (https://newsapi.org) — free 100 req/day
NEWSAPI_KEY=

# CORS
WEB_ORIGIN=http://localhost:5173
