{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "pnpm --filter @truestake/api build",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.ts" }],
  "crons": [
    { "path": "/api/cron/settlement", "schedule": "* * * * *" },
    { "path": "/api/cron/alerts", "schedule": "* * * * *" }
  ]
}
