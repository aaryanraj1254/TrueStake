    "bad-words": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "nanoid": "^5.0.9",
    "node-fetch": "^3.3.2",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.5",
    "resend": "^4.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
