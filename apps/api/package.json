    "bad-words": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "nanoid": "^5.0.9",
    "node-fetch": "^3.3.2",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.5",
    "resend": "^6.12.4",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
